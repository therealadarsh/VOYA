# Copy to .env (gitignored) and fill in locally. Never commit real keys.
# Production (VOYA_ENV=production) refuses to start until the invite code,
# https public URL, absolute data directory, and SMTP values are set.
VOYA_ENV=development
VOYA_DEV_SIGNIN=1
VOYA_PREVIEW_LABEL=1
VOYA_INVITE_CODE=
VOYA_PUBLIC_URL=http://localhost:8000
VOYA_DATA_DIR=
VOYA_DB=
VOYA_LOG_FORMAT=
VOYA_SMTP_HOST=
VOYA_SMTP_PORT=587
VOYA_SMTP_USERNAME=
VOYA_SMTP_PASSWORD=
VOYA_SMTP_FROM=
OPENROUTER_API_KEY=
VOYA_LLM_MODEL_HELPER=
VOYA_LLM_MODEL_NARRATOR=
NPS_API_KEY=
RIDB_API_KEY=
PLACES_API_KEY=
VOYA_TASK_BUDGET_USD=0.15
VOYA_USER_DAILY_BUDGET_USD=1.50
VOYA_MONTHLY_BUDGET_USD=30
DATABASE_URL=postgresql://localhost/voya
